{
  "name": "@mlhkinfotech/types",
  "version": "1.0.3",
  "description": "Shared TypeScript definitions and contracts for MLHK AI WhatsApp Ecosystem",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlhkinfotech/wacore.git",
    "directory": "packages/types"
  },
  "homepage": "https://github.com/mlhkinfotech/wacore#readme",
  "bugs": {
    "url": "https://github.com/mlhkinfotech/wacore/issues"
  }
}
