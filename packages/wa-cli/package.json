{
  "name": "@mlhkinfotech/wa-cli",
  "version": "1.0.1",
  "description": "Command-line tool to bootstrap and manage MLHK WhatsApp AI Agent projects",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wa-cli": "./dist/index.js",
    "mlhk-wa": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mlhkinfotech/types": "workspace:*",
    "@mlhkinfotech/wa-server": "workspace:*",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
